# Database — SQLite for dev (zero-config). For Postgres set:
# DATABASE_URL="postgresql://user:pass@localhost:5432/crm?schema=public"
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET="change-me-access-secret-in-production"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# CORS — frontend origin
CLIENT_ORIGIN="http://localhost:5173"

# Uploads
UPLOAD_DIR="./uploads"
